{
  "version": 2,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/arm-none-eabi.cmake",
        "CANABLE_MCU": "STM32F072CB",
        "CANABLE_BOARD": "BLUEPILL",
        "CANABLE_USB_PROTOCOL": "GS_USB"
      }
    },
    {
      "name": "debug",
      "displayName": "Blue Pill STM32F072CB - SocketCAN Debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Blue Pill STM32F072CB - SocketCAN Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "can-x",
      "displayName": "Blue Pill STM32F072CB - legacy CAN-X Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CANABLE_USB_PROTOCOL": "CAN_X"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "can-x",
      "configurePreset": "can-x"
    }
  ]
}
